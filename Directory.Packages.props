<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Applies the versions below to transitive dependencies too. Aspire.Hosting pulls MessagePack
      2.5.192, which carries published advisories; with TreatWarningsAsErrors that fails the build.
      Pinning centrally lifts it everywhere rather than relying on each project to reference the
      package it doesn't otherwise use.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- Nuget package versions -->
    <AkkaHostingVersion>1.5.68</AkkaHostingVersion>
    <AkkaAspireVersion>0.2.1</AkkaAspireVersion>
    <AspireVersion>13.3.5</AspireVersion>
    <OpenTelemetryVersion>1.15.2</OpenTelemetryVersion>
  </PropertyGroup>
  <!-- App dependencies -->
  <ItemGroup>
    <PackageVersion Include="Akka.Cluster.Hosting" Version="$(AkkaHostingVersion)"/>
    <PackageVersion Include="Akka.Persistence.Hosting" Version="$(AkkaHostingVersion)" />
    <PackageVersion Include="Akka.Persistence.Redis.Hosting" Version="$(AkkaHostingVersion)" />
    <PackageVersion Include="Aaron.Akka.Aspire" Version="$(AkkaAspireVersion)" />
    <PackageVersion Include="Aaron.Akka.Aspire.Hosting" Version="$(AkkaAspireVersion)" />
    <PackageVersion Include="Aaron.Akka.Discovery.Redis" Version="$(AkkaAspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="$(AspireVersion)" />
    <PackageVersion Include="MessagePack" Version="3.1.8" />
    <!-- Pinned transitively: Akka.Hosting 1.5.68 pulls OpenTelemetry.Api 1.10.0, which carries
         published advisories that fail the build under TreatWarningsAsErrors. Lift it to our OTel line. -->
    <PackageVersion Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
  </ItemGroup>
  <!-- Test dependencies -->
  <ItemGroup>
    <PackageVersion Include="Akka.Hosting.TestKit" Version="$(AkkaHostingVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
